# RunPod SSH Configuration Environment Variables
# Copy to .env and customize

# 1Password vault containing SSH credentials
OP_VAULT=Private

# 1Password item name for RunPod SSH key
OP_ITEM=RunPod-B200-SSH

# 1Password field containing private key
OP_FIELD=private_key

# Local path for SSH key storage
SSH_KEY_PATH=~/.ssh/runpod-b200

# RunPod pod identifier (for reference)
RUNPOD_POD_ID=

# RunPod SSH endpoint (default: ssh.runpod.io)
RUNPOD_SSH_HOST=ssh.runpod.io
